rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }

    function isInstructor() {
      return isAuthenticated() &&
        (isAdmin() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'INSTRUCTOR'));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.email is string &&
             data.role in ['ADMIN', 'INSTRUCTOR', 'STUDENT'] &&
             (data.role == 'STUDENT' || isAdmin());
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll(['userId', 'courseId', 'status', 'enrolledAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.courseId is string &&
             data.status in ['ENROLLED', 'IN_PROGRESS', 'COMPLETED'] &&
             data.enrolledAt is timestamp &&
             (!('progress' in data) || data.progress is number) &&
             (!('completedLessons' in data) || data.completedLessons is list);
    }

    function isValidQuizAttempt(data) {
      return data.keys().hasAll(['userId', 'courseId', 'quizId', 'score', 'totalQuestions', 'completedAt', 'passed']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.courseId is string &&
             data.quizId is string &&
             data.score is number &&
             data.totalQuestions is number &&
             data.completedAt is timestamp &&
             data.passed is bool;
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['userId', 'courseId', 'courseTitle', 'userName', 'issuedAt', 'certificateId']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.courseId is string &&
             data.courseTitle is string &&
             data.userName is string &&
             data.issuedAt is timestamp &&
             data.certificateId is string;
    }

    // One Action Card output: { text, rev, updatedAt }. Keep MAX in step with src/lib/actionCardLogic.ts.
    function isValidActionOutput(o) {
      return o is map &&
             o.keys().hasAll(['text', 'rev']) &&
             o.text is string && o.text.size() <= 800 &&
             o.rev is int && o.rev >= 1;
    }

    // actionCards/{uid}_{courseId}: owner-only, six independent outputs m1..m6, tied to an existing enrollment.
    function isValidActionCard(data, cardId) {
      return data.keys().hasAll(['userId', 'courseId', 'outputs']) &&
             data.keys().hasOnly(['userId', 'courseId', 'outputs', 'updatedAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.courseId is string &&
             cardId == request.auth.uid + '_' + data.courseId &&
             data.outputs is map &&
             data.outputs.keys().hasOnly(['m1', 'm2', 'm3', 'm4', 'm5', 'm6']) &&
             (!('m1' in data.outputs) || isValidActionOutput(data.outputs.m1)) &&
             (!('m2' in data.outputs) || isValidActionOutput(data.outputs.m2)) &&
             (!('m3' in data.outputs) || isValidActionOutput(data.outputs.m3)) &&
             (!('m4' in data.outputs) || isValidActionOutput(data.outputs.m4)) &&
             (!('m5' in data.outputs) || isValidActionOutput(data.outputs.m5)) &&
             (!('m6' in data.outputs) || isValidActionOutput(data.outputs.m6)) &&
             exists(/databases/$(database)/documents/enrollments/$(cardId));
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['courseId', 'userId', 'userName', 'content', 'createdAt']) &&
             data.courseId is string &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000 &&
             data.createdAt is timestamp &&
             (!('parentId' in data) || data.parentId is string) &&
             (!('likes' in data) || data.likes is list);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isInstructor();

      allow create: if (isOwner(userId) || isAdmin()) &&
                      isValidUser(request.resource.data);

      allow update: if (isOwner(userId) || isAdmin()) &&
                      isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email &&
                      (isOwner(userId) && !isAdmin() ? request.resource.data.role == resource.data.role : true);

      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses {
      allow read: if true;
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isInstructor());

      // Clients may only self-enroll directly for courses flagged free in
      // Firestore. Paid enrollments are written exclusively by trusted
      // server code (the Stripe webhook and /api/verify-enrollment) using
      // the Admin SDK, which bypasses these rules — a client can never
      // grant itself a paid enrollment by calling setDoc directly.
      allow create: if isAuthenticated() &&
                      isValidEnrollment(request.resource.data) &&
                      request.resource.data.userId == request.auth.uid &&
                      get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.isFree == true;

      allow update: if isAuthenticated() &&
                      (request.auth.uid == resource.data.userId || isAdmin()) &&
                      isValidEnrollment(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.courseId == resource.data.courseId;
    }

    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isInstructor());

      allow create: if isAuthenticated() &&
                      isValidQuizAttempt(request.resource.data) &&
                      request.resource.data.userId == request.auth.uid;
    }

    match /certificates/{certificateId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isInstructor());

      allow create: if isAuthenticated() &&
                      isValidCertificate(request.resource.data) &&
                      request.resource.data.userId == request.auth.uid;
    }

    // Private learner work. Only the owner can read or write it (instructors and admins use server tools, not rules).
    // resource == null lets the owner's first read of a not-yet-created card return "empty" instead of an error;
    // it reveals nothing because a missing document has no content.
    match /actionCards/{cardId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if false;

      allow create: if isAuthenticated() && isValidActionCard(request.resource.data, cardId);

      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      isValidActionCard(request.resource.data, cardId) &&
                      request.resource.data.courseId == resource.data.courseId;

      allow delete: if false;
    }

    match /forumPosts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                      isValidForumPost(request.resource.data) &&
                      request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
                      (request.auth.uid == resource.data.userId || isAdmin()) &&
                      isValidForumPost(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Analytics: authenticated writes only (prevents spam from anonymous visitors)
    match /analytics/{eventId} {
      allow read: if isInstructor();
      allow create: if isAuthenticated();
    }

    // Leads: anyone can submit (public lead form), only admins can read
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Webinars: the public schedule/status is readable by the landing page.
    // All writes happen server-side (Admin SDK via /api/admin), so clients can never write.
    // webinarPrivate (Google Meet link), webinarRegistrations (attendee data) and
    // webinarRateLimits are server-only and fall through to the default deny below.
    match /webinars/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
