# ─────────────────────────────────────────────────────────────────────────────
# MY LEARNING LAUNCHPAD — Environment Variables
# Copy to .env.local for local development.
# Set all of these in the Vercel Dashboard (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Client SDK — safe to expose) ───────────────────────────────────
# These come from firebase-applet-config.json. On Vercel, set them individually.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# ── Firebase (Admin SDK — server-side only, NEVER expose to client) ───────────
# Generate a service account key in Firebase Console → Project Settings → Service Accounts.
# Paste the entire JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Needed for the auth-login fallback route
FIREBASE_WEB_API_KEY=

# If you use a named Firestore database (leave blank for "(default)")
FIRESTORE_DATABASE_ID=

# Firebase Storage bucket (e.g. my-project.appspot.com) — needed for file uploads
FIREBASE_STORAGE_BUCKET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Get from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (Email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=info@mylearninglaunchpad.com

# ── App Config ────────────────────────────────────────────────────────────────
# The canonical URL of your site (no trailing slash)
APP_URL=https://mylearninglaunchpad.com

# Admin email — this user gets ADMIN role on first login
ADMIN_EMAIL=your-admin@email.com
VITE_ADMIN_EMAIL=your-admin@email.com

# ── Webinar funnel (see docs/WEBINAR.md) ─────────────────────────────────────
# Public site URL used in email links and social tags (no trailing slash)
SITE_URL=https://www.mylearninglaunchpad.com
# Secret for signing unsubscribe links. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it, promotional webinar emails are disabled (confirmations/reminders still work).
WEBINAR_TOKEN_SECRET=
# Optional: sender for webinar mail (defaults to RESEND_FROM_EMAIL). Must be on a domain verified in Resend.
WEBINAR_FROM_EMAIL=
# Optional: contact shown in webinar emails (defaults to info@mylearninglaunchpad.com)
WEBINAR_CONTACT_EMAIL=
# Optional: event the /webinar page loads (defaults to leading-ai-hype-to-strategy)
VITE_WEBINAR_EVENT_ID=
# Optional: social share image path or absolute URL, used at build time (defaults to the instructor photo)
WEBINAR_OG_IMAGE=

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PDF guide download URL (leave blank to serve from /public/downloads/)
VITE_GUIDE_PDF_URL=
